def _record_flags(rest: list[str]) -> tuple[list[str], dict]:
    out = None
    fps = 10
    pos = []
    i = 0
    while i < len(rest):
        if rest[i] == "--out" and i + 1 < len(rest):
            out = rest[i + 1]
            i += 2
            continue
        if rest[i] == "--fps" and i + 1 < len(rest):
            fps = int(rest[i + 1])
            i += 2
            continue
        pos.append(rest[i])
        i += 1
    return pos, {"out": out, "fps": fps}


def cmd_record(doc: dict, rest: list[str], json_mode: bool) -> int:
    pos, flags = _record_flags(rest)
    if len(pos) < 2:
        return emit(
            {"error": "record <id> start|stop|status"},
            json_mode,
            "record <id> start|stop|status",
            2,
        )
    tid, action = pos[0], pos[1]
    row = find_tenant(doc, tid)
    container = vnc_container(row)
    try:
        with steering(tid, "record"):
            if action == "start":
                dest = flags["out"] or str(
                    record_lib.state_dir() / f"{tid}-{int(time.time())}.mp4"
                )
                payload = record_lib.start(tid, container, dest, fps=flags["fps"])
                return emit(payload, json_mode, f"record start {tid} pid={payload['pid']} out={payload['out']}")
            if action == "stop":
                payload = record_lib.stop(tid, container)
                return emit(payload, json_mode, f"record stop {tid} {payload['out']} bytes={payload['bytes']}")
            if action == "status":
                payload = record_lib.status(tid, container)
                rec = "recording" if payload.get("recording") else "idle"
                return emit(payload, json_mode, f"record {tid} {rec}")
    except Exception as e:
        return emit({"error": str(e), "id": tid, "action": action}, json_mode, str(e), 1)
    return emit({"error": f"unknown record action {action}"}, json_mode, f"record <id> start|stop|status", 2)


def cmd_vnc_click(doc: dict, rest: list[str], json_mode: bool) -> int:
    if len(rest) < 3:
        return emit({"error": "vnc-click <id> <x> <y>"}, json_mode, "vnc-click <id> <x> <y>", 2)
    row = find_tenant(doc, rest[0])
    x, y = rest[1], rest[2]
    container = vnc_container(row)
    with steering(row["id"], "click"):
        proc = docker_exec(container, ["xdotool", "mousemove", "--sync", x, y, "click", "1"], check=False)
    payload = {"ok": proc.returncode == 0, "via": "vnc", "x": x, "y": y, "stderr": (proc.stderr or "").strip()[:200]}
    return emit(payload, json_mode, f"vnc-click {x},{y} ok={payload['ok']}", 0 if payload["ok"] else 1)


def cmd_vaults(rest: list[str], json_mode: bool) -> int:
    if not rest or rest[0] in ("list", "status"):
        data = vault_lib.describe_vaults()
        lines = [f"write={data['write']}  config={data['config']}"]
        for v in data["vaults"]:
            mark = "builtin" if v.get("builtin") else "connected"
            lines.append(f"{v['id']:12} {v['kind']:12} {mark:10} {v.get('path')}")
        return emit(data, json_mode, "\n".join(lines))
    sub, args = rest[0], rest[1:]
    if sub == "connect":
        if len(args) < 2:
            return emit({"error": "vaults connect <kind> <path>"}, json_mode, "vaults connect <kind> <path> [--id name]", 2)
        kind, path = args[0], args[1]
        vid = None
        label = None
        i = 2
        while i < len(args):
            if args[i] == "--id" and i + 1 < len(args):
                vid = args[i + 1]
                i += 2
            elif args[i] == "--label" and i + 1 < len(args):
                label = args[i + 1]
                i += 2
            else:
                i += 1
        try:
            row = vault_lib.connect(kind, path, vault_id=vid, label=label)
        except ValueError as e:
            return emit({"error": str(e)}, json_mode, str(e), 2)
        return emit(row, json_mode, f"connected {row['id']} ({row['kind']}) → {row['path']}")
    if sub == "disconnect":
        if not args:
            return emit({"error": "vaults disconnect <id>"}, json_mode, "vaults disconnect <id>", 2)
        ok = vault_lib.disconnect(args[0])
        return emit({"ok": ok, "id": args[0]}, json_mode, f"disconnect {args[0]} ok={ok}", 0 if ok else 1)
    if sub == "write":
        if not args:
            return emit({"error": "vaults write <id>"}, json_mode, "vaults write <id>", 2)
        try:
            vid = vault_lib.set_write(args[0])
        except ValueError as e:
            return emit({"error": str(e)}, json_mode, str(e), 2)
        return emit({"write": vid}, json_mode, f"write → {vid}")
    return emit({"error": f"unknown vaults subcommand {sub}"}, json_mode, f"unknown vaults subcommand {sub}", 2)


def cmd_test(json_mode: bool) -> int:
    proc = subprocess.run(
        [sys.executable, "-m", "pytest", str(ROOT / "tests"), "-q", "--tb=short"],
        cwd=str(ROOT),
    )
    ok = proc.returncode == 0
    return emit({"ok": ok, "code": proc.returncode}, json_mode, "tests ok" if ok else "tests failed", 0 if ok else 1)


def cmd_doctor(doc: dict, json_mode: bool) -> int:
    rows = tenants(doc)
    reports = [glass_status(r) for r in rows]
    ids = [r["id"] for r in reports]
    live = [r for r in reports if r["state"] == "live"]
    no_glass = [r for r in reports if r["state"] == "no-glass"]
    findings = []
    if not rows:
        findings.append("tenants.json has no tenants — copy tenants.example.json")
    seen = set()
    for t in rows:
        tid = t.get("id")
        if not tid:
            findings.append("tenant missing id")
            continue
        if tid in seen:
            findings.append(f"duplicate tenant id {tid}")
        seen.add(tid)
        glass = t.get("glass")
        if not glass:
            continue
        for key in ("container", "vnc", "cdp"):
            if not glass.get(key):
                findings.append(f"{tid} glass missing {key}")
    for r in live:
        container = ((r.get("glass") or {}).get("container"))
        fs, fs_detail = jar_fullscreen(container)
        if fs:
            findings.append(f"{r['id']} chromium is fullscreen ({fs_detail}) — tabs/url hidden")
    cdp_ok = False
    cdp_detail = "no live cdp"
    if live:
        try:
            ver = cdp_lib.version(cdp_base(find_tenant(doc, live[0]["id"])))
            cdp_ok = True
            cdp_detail = ver.get("Browser") or "ok"
        except Exception as e:
            cdp_detail = str(e)[:120]
            findings.append(f"cdp: {cdp_detail}")
    desk_ok, desk_detail = desk_health()
    ok = not findings
    payload = {
        "ok": ok,
        "source": doc.get("source") or "file",
        "path": str(TENANTS_PATH),
        "desk": {"url": DESK_URL, "ok": desk_ok, "detail": desk_detail},
        "cdp": {"ok": cdp_ok, "detail": cdp_detail},
        "tenants": ids,
        "live": [r["id"] for r in live],
        "no_glass": [r["id"] for r in no_glass],
        "findings": findings,
        "reports": reports,
    }
    text = (
        f"ok={ok} source={payload['source']} live={','.join(payload['live']) or '-'} "
        f"no-glass={len(no_glass)}/{len(reports)} desk={'up' if desk_ok else 'down'} "
        f"cdp={'up' if cdp_ok else 'down'}"
    )
    if findings:
        text += "\n" + "\n".join(f"- {f}" for f in findings)
    return emit(payload, json_mode, text, 0 if ok else 1)


def main(argv: list[str]) -> int:
    args = argv[1:]
    json_mode = want_json(args)
    if not args or args[0] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    pos = strip_flags(args)
    if not pos:
        sys.stdout.write(USAGE)
        return 0
    cmd, rest = pos[0], pos[1:]
    if cmd == "test":
        return cmd_test(json_mode)
    if cmd == "vaults":
        return cmd_vaults(rest, json_mode)
    doc = load_doc()
    if cmd in ("tenants", "list"):
        return cmd_tenants(doc, json_mode)
    if cmd == "status":
        return cmd_status(doc, rest[0] if rest else None, json_mode)
    if cmd == "target":
        return cmd_target(doc, rest[0] if rest else None, json_mode)
    if cmd == "vnc":
        return cmd_vnc(doc, rest[0] if rest else None, json_mode)
    if cmd == "serve":
        return cmd_serve(json_mode)
    if cmd in ("open", "desk"):
        return cmd_open(json_mode)
    if cmd == "tabs":
        return cmd_tabs(doc, rest, json_mode)
    if cmd == "screenshot":
        return cmd_screenshot(doc, rest, json_mode)
    if cmd == "nav":
        return cmd_nav(doc, rest, json_mode)
    if cmd == "focus":
        return cmd_focus(doc, rest, json_mode)
    if cmd == "click":
        return cmd_click(doc, rest, json_mode)
    if cmd == "type":
        return cmd_type(doc, rest, json_mode)
    if cmd == "vnc-key":
        return cmd_vnc_key(doc, rest, json_mode)
    if cmd == "vnc-type":
        return cmd_vnc_type(doc, rest, json_mode)
    if cmd == "vnc-move":
        return cmd_vnc_move(doc, rest, json_mode)
    if cmd == "vnc-click":
        return cmd_vnc_click(doc, rest, json_mode)
    if cmd == "record":
        return cmd_record(doc, rest, json_mode)
    if cmd == "doctor":
        return cmd_doctor(doc, json_mode)
    return emit({"error": f"unknown command {cmd}"}, json_mode, f"unknown command {cmd}\n{USAGE}", 1)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        raise SystemExit(130)
